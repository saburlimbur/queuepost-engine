# Application settings
HOST=0.0.0.0
PORT=8080

# Allowed web origin for CORS (unset or empty = allow any origin)
CORS_ORIGIN=http://localhost:5173

# Database settings (if using GORM, sqlc, Ent, Bun, or sqlx)
DATABASE_URL=postgres://user:password@localhost:5432/dbname?sslmode=disable

# gRPC settings (if using gRPC)
GRPC_PORT=50051

# Redis (Asynq queue)
REDIS_ADDR=localhost:6379

# Auth (JWT)
JWT_SECRET=change-me-32chars-min
JWT_EXPIRES_IN=7d

# Logging level
LOG_LEVEL=debug
